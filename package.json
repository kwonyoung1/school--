{
  "name": "school-expense-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node --experimental-strip-types server/index.ts",
    "client": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --experimental-strip-types server/index.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "init": "node --experimental-strip-types server/init.ts",
    "test:browser": "node --experimental-strip-types --test tests/browser.e2e.ts",
    "seed": "node --experimental-strip-types server/seed.ts",
    "format": "prettier --write src server tests vite.config.ts tsconfig.json package.json README.md"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
